@model IEnumerable<CategoryProduct.MVC.Models.Product>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
	@if (User.IsInRole("Admin")) { <a asp-action="Create">Create New</a> }
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Price)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Quantity)
			</th>
			<th>
				Category
			</th>
			<th></th>
		</tr>
	</thead>

	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Price)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Quantity)
				</td>
				<td>
					@item.CategoryName
				</td>
				<td>
					@if (User.IsInRole("Admin")) { <text><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |</text> }
					<a asp-action="Details" asp-route-id="@item.Id">Details</a>
					@if (User.IsInRole("Admin")) { <text> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></text> }
				</td>
			</tr>
		}
	</tbody>
</table>

<nav>
	<ul class="pagination">

		@if (ViewBag.CurrentPage > 1)
		{
			<li class="page-item">
				<a class="page-link"
				   href="?page=@(ViewBag.CurrentPage - 1)">
					Previous
				</a>
			</li>
		}


		@for (int i = 1; i <= ViewBag.TotalPages; i++)
		{
			<li class="page-item
				@(i == ViewBag.CurrentPage ? "active" : "")">

				<a class="page-link"
				   href="?page=@i">
					@i
				</a>

			</li>
		}


		@if (ViewBag.CurrentPage < ViewBag.TotalPages)
		{
			<li class="page-item">
				<a class="page-link"
				   href="?page=@(ViewBag.CurrentPage + 1)">
					Next
				</a>
			</li>
		}

	</ul>
</nav>
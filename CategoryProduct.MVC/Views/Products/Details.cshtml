@model CategoryProduct.MVC.Models.Product

@{
	ViewData["Title"] = "Details";
}

<h1>Details</h1>

@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

<div>
	<h4>Product</h4>
	<hr />

	<dl class="row">

		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Name)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Name)
		</dd>

		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Price)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Price)
		</dd>

		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.Quantity)
		</dt>
		<dd class="col-sm-10">
			@Html.DisplayFor(model => model.Quantity)
		</dd>

		<dt class="col-sm-2">
			Category
		</dt>
		<dd class="col-sm-10">
			@Model.CategoryName
		</dd>

	</dl>

	@if (Model.ImageUrl != null)
	{
		<img src="@Url.Action("Image", "Products", new { id = Model.Id })" alt="@Model.Name" class="img-thumbnail mb-3" style="max-width:320px" />
	}

	@if (User.Identity?.IsAuthenticated == true)
	{
		<form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 mb-3" style="max-width:260px">
			<input type="hidden" name="productId" value="@Model.Id" />
			<input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
			<input type="number" name="quantity" value="1" min="1" max="100" class="form-control" />
			<button class="btn btn-primary text-nowrap">Add to cart</button>
		</form>
	}

	@if (User.IsInRole("Admin"))
	{
		<div asp-validation-summary="All" class="text-danger"></div>
		<form asp-action="UploadImage" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mb-2">
			<div class="input-group" style="max-width:480px">
				<input type="file" name="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
				<button type="submit" class="btn btn-primary">@(Model.ImageUrl == null ? "Upload image" : "Replace image")</button>
			</div>
			<span class="form-text">JPG, PNG or WebP, up to 2 MB.</span>
			@Html.AntiForgeryToken()
		</form>
		@if (Model.ImageUrl != null)
		{
			<form asp-action="RemoveImage" asp-route-id="@Model.Id" method="post">
				<button type="submit" class="btn btn-outline-danger btn-sm">Remove image</button>
			</form>
		}
	}
</div>
<div>
	@if (User.IsInRole("Admin")) { <text><a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |</text> }
	<a asp-action="Index">Back to List</a>
</div>

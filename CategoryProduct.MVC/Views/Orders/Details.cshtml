@model CategoryProduct.MVC.Models.OrderModel

@{
	ViewData["Title"] = $"Order #{Model.Id}";
}

<h1>Order #@Model.Id</h1>

@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

<p>
	Placed @Model.CreatedAtUtc.ToLocalTime().ToString("g") &middot;
	<partial name="_OrderStatusBadge" model="Model.Status" />
	@if (User.IsInRole("Admin")) { <text> &middot; @Model.UserName</text> }
</p>

<table class="table">
	<thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Line total</th></tr></thead>
	<tbody>
		@foreach (var item in Model.Items)
		{
			<tr>
				<td>@item.ProductName @if (item.ProductId == null) { <span class="text-muted">(product removed)</span> }</td>
				<td>@item.UnitPrice.ToString("N2")</td>
				<td>@item.Quantity</td>
				<td>@item.LineTotal.ToString("N2")</td>
			</tr>
		}
	</tbody>
	<tfoot><tr><th colspan="3" class="text-end">Total</th><th>@Model.Total.ToString("N2")</th></tr></tfoot>
</table>

<div class="d-flex gap-2 mb-3">
	@if (Model.Status == "Pending")
	{
		<form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
			<button class="btn btn-outline-danger">Cancel order</button>
		</form>
		@if (User.IsInRole("Admin"))
		{
			<form asp-action="SetStatus" asp-route-id="@Model.Id" method="post">
				<input type="hidden" name="status" value="Confirmed" />
				<button class="btn btn-success">Confirm order</button>
			</form>
		}
	}
</div>

<a asp-action="Index">Back to my orders</a>

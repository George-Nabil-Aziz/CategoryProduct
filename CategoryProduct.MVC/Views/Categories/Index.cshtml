@model IEnumerable<CategoryProduct.MVC.Models.Category>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
	@if (User.IsInRole("Admin")) { <a asp-action="Create">Create New</a> }
</p>
<form method="get" class="row g-2 mb-3">
	<div class="col-auto"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name" /></div>
	<div class="col-auto"><button class="btn btn-primary">Search</button> <a asp-action="Index" class="btn btn-link">Reset</a></div>
</form>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(model => item.Name)
				</td>
				<td>
					@if (User.IsInRole("Admin")) { <text><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |</text> }
					<a asp-action="Details" asp-route-id="@item.Id">Details</a>
					@if (User.IsInRole("Admin")) { <text> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></text> }
				</td>
			</tr>
		}
	</tbody>
</table>

<nav>
	<ul class="pagination">

		@if (ViewBag.CurrentPage > 1)
		{
			<li class="page-item">
				<a class="page-link"
				   asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">
					Previous
				</a>
			</li>
		}


		@for (int i = 1; i <= ViewBag.TotalPages; i++)
		{
			<li class="page-item
				@(i == ViewBag.CurrentPage ? "active" : "")">

				<a class="page-link"
				   asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">
					@i
				</a>

			</li>
		}


		@if (ViewBag.CurrentPage < ViewBag.TotalPages)
		{
			<li class="page-item">
				<a class="page-link"
				   asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">
					Next
				</a>
			</li>
		}

	</ul>
</nav>
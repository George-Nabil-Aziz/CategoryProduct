@model CategoryProduct.MVC.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot password";
}

<h1>Forgot password</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <p>Enter your user name or email. If the account has an email address, we send a reset link to it.</p>
        <form asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserNameOrEmail" class="control-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Send reset link" class="btn btn-primary" />
                <a asp-action="Login" class="btn btn-link">Back to login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

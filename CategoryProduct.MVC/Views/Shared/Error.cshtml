@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>An unexpected error occurred while processing your request. Please try again.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Categories" asp-action="Index" class="btn btn-primary">Back to Categories</a>

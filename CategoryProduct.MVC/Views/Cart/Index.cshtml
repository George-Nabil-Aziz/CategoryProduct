@model CategoryProduct.MVC.Models.CartModel

@{
	ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

@if (Model.Items.Count == 0)
{
	<p>Your cart is empty.</p>
	<a asp-controller="Products" asp-action="Index">Browse products</a>
}
else
{
	<table class="table align-middle">
		<thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Line total</th><th></th></tr></thead>
		<tbody>
			@foreach (var line in Model.Items)
			{
				<tr>
					<td>
						@line.ProductName
						@if (line.AvailableQuantity < line.Quantity)
						{
							<span class="badge bg-warning text-dark ms-1">Only @line.AvailableQuantity in stock</span>
						}
					</td>
					<td>@line.UnitPrice.ToString("N2")</td>
					<td>
						<form asp-action="Update" method="post" class="d-flex gap-2">
							<input type="hidden" name="productId" value="@line.ProductId" />
							<input type="number" name="quantity" value="@line.Quantity" min="1" max="100" class="form-control form-control-sm" style="width:90px" />
							<button class="btn btn-sm btn-outline-primary">Update</button>
						</form>
					</td>
					<td>@line.LineTotal.ToString("N2")</td>
					<td>
						<form asp-action="Remove" method="post">
							<input type="hidden" name="productId" value="@line.ProductId" />
							<button class="btn btn-sm btn-outline-danger">Remove</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
		<tfoot><tr><th colspan="3" class="text-end">Total</th><th>@Model.Total.ToString("N2")</th><th></th></tr></tfoot>
	</table>

	<div class="d-flex gap-2">
		<form asp-action="Clear" method="post"><button class="btn btn-outline-secondary">Clear cart</button></form>
		<form asp-action="Checkout" method="post"><button class="btn btn-primary">Checkout</button></form>
	</div>
}

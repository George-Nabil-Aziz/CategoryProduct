# Copy to .env and replace the placeholders. Never commit .env.

# SQL Server SA password. Must be at least 8 characters and contain 3 of 4:
# uppercase, lowercase, digit, symbol. Do NOT use ; = $ quotes or spaces
# (they break the connection string and compose interpolation).
SA_PASSWORD=CHANGE_ME_Sa-Password-1

# JWT signing key. At least 32 characters. Generate a random value.
JWT_KEY=CHANGE_ME_replace_with_a_random_string_of_32_chars_or_more

# Host ports (defaults shown)
API_HOST_PORT=5028
MVC_HOST_PORT=5256
